generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?

  image String?

  destinations Destination[]
  packages     Package[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Destination {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String? @unique
  description String
  price       Float?

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images Image[]

  packages  Package[]
  contents  Content[]
  locations Location[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String? @unique
  description String
  price       Float

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  destinationId Int?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id Int @id @default(autoincrement())

  title       String
  subTitle    String?
  description String

  dateAvailable DateTime
  isAvailable   Boolean  @default(true)

  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id Int @id @default(autoincrement())

  title       String
  description String?
  hrefLink    String?

  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id  Int    @id @default(autoincrement())
  url String
  key String

  altText String?
  isMain  Boolean @default(false)
  order   Int?

  destinationId Int?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  packageId Int?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  contentId Int?
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String?
  name     String?
  role     UserRole @default(USER)
  image    String?
  phone    String?
  provider String   @default("credentials")

  emailVerified     Boolean   @default(false)
  verificationToken String?
  tokenExpiry       DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?

  loginAttempts    Int       @default(0)
  loginLockedUntil DateTime?

  bookings       Booking[]
  wishlistItems  WishlistItem[]
  savedTravelers SavedTraveler[]
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productCode String // Viator productCode OR local slug
  source      String // "viator" | "local" | "tourcms"
  title       String
  imageUrl    String?
  price       Float?
  currency    String?
  href        String? // resolved navigation target

  createdAt DateTime @default(now())

  @@unique([userId, productCode, source])
  @@index([userId])
}

model SavedTraveler {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName           String
  lastName            String
  ageBand             String // ADULT | CHILD | INFANT | SENIOR | YOUTH
  dateOfBirth         DateTime?
  passportNumber      String?
  passportExpiry      DateTime?
  nationality         String?
  dietaryRequirements String?
  pickupHotel         String?
  isLead              Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Review {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingId Int?     @unique
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  productCode  String
  source       String // "viator" | "local" | "tourcms"
  rating       Int // 1-5
  title        String?
  body         String
  photos       Json? // array of S3 URLs
  status       ReviewStatus @default(PENDING)
  helpfulCount Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productCode, source, status])
  @@index([userId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Booking {
  id            Int           @id @default(autoincrement())
  bookingRef    String
  productCode   String
  productTitle  String
  productImage  String?
  totalPrice    Float
  totalPriceUsd Float?
  currency      String        @default("IDR")
  travelDate    DateTime
  travelTime    String?
  meetingPoint  String?
  pax           Int           @default(1)
  status        BookingStatus @default(PENDING)

  // Viator booking fields
  productOptionCode    String?
  productOptionTitle   String?
  tourGradeCode        String?
  startTime            String?
  paxMixJson           Json?
  bookingQuestionsJson Json?
  languageGuide        String?

  // Lead traveler contact
  leadFirstName String?
  leadLastName  String?
  leadEmail     String?
  leadPhone     String?

  travelersJson  Json?
  isFraudFlagged Boolean @default(false)
  voucherEmailed Boolean @default(false)

  // Payment
  paymentId      String?   @unique
  snapToken      String?
  paidAt         DateTime?
  idempotencyKey String?   @unique

  // Viator confirmation
  viatorBookingRef    String?
  viatorBookingStatus String?
  viatorVoucherUrl    String?
  viatorBookingError  String?
  viatorRetryCount    Int     @default(0)

  ticketToken     String? @unique
  ticketImageUrl  String? // Uploaded Viator ticket image (required before confirming)
  paymentProofUrl String? // Admin-uploaded payment proof (m-banking screenshot)

  reminderSentAt DateTime? // T-1 day reminder email send timestamp

  // Mock/manual booking fields
  isMockMode    Boolean @default(false)
  manualPrice   Float?
  promoCode     String?
  documentsJson Json?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  travelers BookingTraveler[]
  review    Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingTraveler {
  id         Int    @id @default(autoincrement())
  bookingRef String
  firstName  String
  lastName   String
  fullName   String
  ageBand    String

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

model Subscription {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("ACTIVE") // ACTIVE or UNSUBSCRIBED
  source    String   @default("WEBSITE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model MockBooking {
  id                 Int     @id @default(autoincrement())
  slug               String  @unique
  productCode        String
  productTitle       String
  productImage       String?
  price              Float?
  currency           String  @default("IDR")
  username           String?
  promoCode          String?
  productOptionCode  String?
  productOptionTitle String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
