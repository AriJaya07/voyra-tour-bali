generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?

  image String?

  destinations Destination[]
  packages     Package[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Destination {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String? @unique
  description String
  price       Float?

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images Image[]

  packages  Package[]
  contents  Content[]
  locations Location[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String? @unique
  description String
  price       Float

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  destinationId Int?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id Int @id @default(autoincrement())

  title       String
  subTitle    String?
  description String

  dateAvailable DateTime
  isAvailable   Boolean  @default(true)

  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id Int @id @default(autoincrement())

  title       String
  description String?
  hrefLink    String?

  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  images Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id  Int    @id @default(autoincrement())
  url String
  key String

  altText String?
  isMain  Boolean @default(false)
  order   Int?

  destinationId Int?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  packageId Int?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  contentId Int?
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String?
  name     String?
  role     UserRole @default(USER)
  image    String?
  phone    String?
  provider String   @default("credentials")

  emailVerified     Boolean   @default(false)
  verificationToken String?
  tokenExpiry       DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?

  loginAttempts    Int       @default(0)
  loginLockedUntil DateTime?

  currency String @default("USD")

  // AI welcome grant idempotency. Set once at signup grant time.
  aiWelcomeGrantedAt DateTime?

  bookings       Booking[]
  wishlistItems  WishlistItem[]
  recentlyViewed RecentlyViewedItem[]
  savedTravelers SavedTraveler[]
  importedTrips  ImportedTrip[]
  preferences    UserPreferences?
  baliNotes      BaliNote[]
  itineraries    SavedItinerary[]
  calendarEvents CalendarEvent[]
  calendarShareSlug    String?  @unique
  calendarShareEnabled Boolean  @default(false)
  notificationPref NotificationPref?
  loyalty        LoyaltyAccount?
  loyaltyLedger  LoyaltyLedger[]
  referralsSent  Referral[]       @relation("ReferralInviter")
  referredById   Int?
  referredBy     User?            @relation("ReferredBy", fields: [referredById], references: [id])
  referredUsers  User[]           @relation("ReferredBy")
  operatorAccount Operator?
  pushSubscriptions PushSubscription[]

  appNotifications        AppNotification[]
  notificationTemplates   NotificationTemplate[]   @relation("TplCreatedBy")
  notificationBroadcasts  NotificationBroadcast[]  @relation("BroadcastCreatedBy")

  aiSubscription   AiSubscription?
  aiWallet         AiCreditWallet?
  aiGrants         AiCreditGrant[]
  aiLedger         AiCreditLedger[]
  aiUsage          AiUsage[]
  aiPayments       AiPayment[]
  aiChatMemory     AiChatMemory?
  aiFamilyOwned    AiFamilySeat[]   @relation("AiSeatOwner")
  aiFamilySeat     AiFamilySeat?    @relation("AiSeatMember")
  signupFingerprint SignupFingerprint?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productCode String // Viator productCode OR local slug
  source      String // "viator" | "local" | "tourcms"
  title       String
  imageUrl    String?
  price       Float?
  currency    String?
  href        String? // resolved navigation target

  priceAtSave    Float?
  currencyAtSave String?
  savedAt        DateTime  @default(now())

  createdAt DateTime @default(now())

  @@unique([userId, productCode, source])
  @@index([userId])
}

model ImportedTrip {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  source       String   @default("viator") // viator | external
  externalRef  String?
  productTitle String
  productImage String?
  travelDate   DateTime?
  notes        String?
  href         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, travelDate])
}

model UserPreferences {
  userId         Int      @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  partyAdults    Int      @default(2)
  partyChildren  Int      @default(0)
  partySeniors   Int      @default(0)
  partyInfants   Int      @default(0)
  styleTags      String[] @default([])
  dietary        String?
  mobility       String?
  regionPref     String?
  tripLengthDays Int?

  updatedAt      DateTime @updatedAt
}

model BaliNote {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetType  String   // tour | destination | place
  targetKey   String
  targetTitle String?
  rating      Int?
  body        String
  photos      Json?
  date        DateTime? // optional date the note refers to (visit/event day)
  visibility  String   @default("PRIVATE") // PRIVATE | PUBLIC
  status      String   @default("APPROVED") // APPROVED | PENDING | REJECTED

  calendarEvents CalendarEvent[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([targetType, targetKey])
  @@index([visibility, status])
}

model CalendarEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  notes     String?
  date      DateTime
  startTime String?
  endTime   String?
  location  String?
  color     String?
  noteId    Int?
  baliNote  BaliNote? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  // Recurrence (RFC5545 subset). null = one-time.
  recurrence       String?    // FREQ=DAILY|WEEKLY|MONTHLY[;INTERVAL=n][;BYDAY=MO,...]
  recurrenceUntil  DateTime?  // last day inclusive; null = no limit
  reminderSent     Boolean    @default(false)
  visibility       String     @default("PRIVATE") // PRIVATE | PUBLIC (per-event override)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([noteId])
}

model SavedItinerary {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String
  fromDate   DateTime?
  toDate     DateTime?
  party      Json?    // { adults, children, seniors, infants }
  itemsJson  Json     // [{ day, slot, productCode, source, title, notes, href }]
  visibility String   @default("PRIVATE") // PRIVATE | PUBLIC
  shareSlug  String?  @unique

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([visibility, shareSlug])
}

model BaliEvent {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  date        DateTime
  endDate     DateTime?
  type        String   // FESTIVAL | CEREMONY | PUBLIC_HOLIDAY | NYEPI
  region      String?
  description String
  impact      String?  // free-form: "Full island shutdown", "Temple visits restricted", etc.
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([type])
}

model TourGuide {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  photo       String?
  bio         String?
  languages   String[] @default([])
  yearsActive Int      @default(0)
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Operator {
  id            Int      @id @default(autoincrement())
  ownerUserId   Int      @unique
  ownerUser     User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  name          String
  slug          String   @unique
  email         String
  phone         String?
  whatsapp      String?
  website       String?
  description   String?

  licenseNo     String
  insurance     Boolean  @default(false)
  yearsActive   Int      @default(0)

  rating        Float    @default(0)
  reviewCount   Int      @default(0)

  status        String   @default("PENDING") // PENDING | APPROVED | SUSPENDED | REJECTED
  rejectReason  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model Guide {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  excerpt     String
  body        String   // markdown
  coverImage  String?
  region      String?  // Ubud | Canggu | etc
  tags        String[] @default([])
  status      String   @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt DateTime?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([region, status])
}

model EmailDelivery {
  id           Int      @id @default(autoincrement())
  campaignId   String?
  userId       Int
  type         String
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  unsubscribed Boolean  @default(false)
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([type, sentAt])
}

model LoyaltyAccount {
  userId        Int      @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  pointsBalance Int      @default(0)
  tier          String   @default("BRONZE") // BRONZE | SILVER | GOLD
  lifetimeSpend Float    @default(0)

  updatedAt     DateTime @updatedAt
}

model LoyaltyLedger {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  delta     Int
  reason    String   // BOOKING | REFERRAL | REDEEM | ADJUST | SIGNUP
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Referral {
  id           Int      @id @default(autoincrement())
  inviterId    Int
  inviter      User     @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  inviteeEmail String
  inviteeId    Int?
  code         String   @unique
  status       String   @default("PENDING") // PENDING | SIGNED_UP | ACTIVE | DECLINED
  rewardGiven  Boolean  @default(false)

  // Per-booking referral tally — every confirmed invitee booking pays the inviter.
  bookingsCount  Int       @default(0)
  totalRewarded  Int       @default(0)
  firstBookingAt DateTime?

  // Idempotency for invitee signup bonus + analytics
  firstSignupBonusGivenAt DateTime?
  attributionSource       String?   // share_link | email | code_input | whatsapp | x | facebook | native_share
  lastSharedAt            DateTime?
  suspiciousReason        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([inviterId])
  @@index([inviteeId])
  @@unique([inviterId, inviteeEmail])
}

model SignupFingerprint {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipHash    String?
  uaHash    String?
  phoneHash String?

  createdAt DateTime @default(now())

  @@index([ipHash])
  @@index([phoneHash])
  @@index([uaHash, createdAt])
}

model NotificationPref {
  userId          Int      @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  weatherAlerts     Boolean  @default(false)
  volcanoAlerts     Boolean  @default(true)
  nyepiAlert        Boolean  @default(true)
  tripReminders     Boolean  @default(true)
  calendarReminders Boolean  @default(true)
  marketingEmails   Boolean  @default(false)
  inAppMutedCategories Json @default("[]")

  updatedAt       DateTime @updatedAt
}

model NotificationTemplate {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  title       String
  body        String
  category    String
  url         String?
  iconKey     String?
  archivedAt  DateTime?
  createdById Int
  createdBy   User      @relation("TplCreatedBy", fields: [createdById], references: [id])
  broadcasts  NotificationBroadcast[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, archivedAt])
}

model NotificationBroadcast {
  id           Int       @id @default(autoincrement())
  templateId   Int?
  template     NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  title        String
  body         String
  category     String
  url          String?
  iconKey      String?

  audience     String                       // ALL | ROLE_USER | ROLE_ADMIN | USER_LIST
  audienceIds  Json?
  channels     Json                         // { inApp: true, push: false, email: false }

  scheduledAt  DateTime?
  sentAt       DateTime?
  status       String     @default("DRAFT") // DRAFT | SCHEDULED | SENDING | SENT | FAILED | CANCELLED
  errorMessage String?

  createdById  Int
  createdBy    User       @relation("BroadcastCreatedBy", fields: [createdById], references: [id])

  notifications AppNotification[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([sentAt])
}

model AppNotification {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcastId Int?
  broadcast   NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  title       String
  body        String
  category    String
  url         String?
  iconKey     String?

  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, dismissedAt, createdAt])
  @@index([broadcastId])
  @@unique([broadcastId, userId])
}

model RecentlyViewedItem {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productCode String
  source      String
  title       String
  imageUrl    String?
  price       Float?
  currency    String?
  href        String?

  viewedAt DateTime @default(now())

  @@unique([userId, productCode, source])
  @@index([userId])
  @@index([userId, viewedAt])
}

model SavedTraveler {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName           String
  lastName            String
  ageBand             String // ADULT | CHILD | INFANT | SENIOR | YOUTH
  dateOfBirth         DateTime?
  passportNumber      String?
  passportExpiry      DateTime?
  nationality         String?
  dietaryRequirements String?
  pickupHotel         String?
  isLead              Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Booking {
  id            Int           @id @default(autoincrement())
  bookingRef    String
  source        String        @default("viator") // viator | local | tourcms
  productCode   String
  productTitle  String
  productImage  String?
  totalPrice    Float
  totalPriceUsd Float?
  currency      String        @default("IDR")
  travelDate    DateTime
  travelTime    String?
  meetingPoint  String?
  pax           Int           @default(1)
  status        BookingStatus @default(PENDING)

  // Viator booking fields
  productOptionCode    String?
  productOptionTitle   String?
  tourGradeCode        String?
  startTime            String?
  paxMixJson           Json?
  bookingQuestionsJson Json?
  languageGuide        String?

  // Lead traveler contact
  leadFirstName String?
  leadLastName  String?
  leadEmail     String?
  leadPhone     String?

  travelersJson  Json?
  isFraudFlagged Boolean @default(false)
  voucherEmailed Boolean @default(false)

  // Payment
  paymentId      String?   @unique
  snapToken      String?
  paidAt         DateTime?
  idempotencyKey String?   @unique

  // Viator confirmation
  viatorBookingRef    String?
  viatorBookingStatus String?
  viatorVoucherUrl    String?
  viatorBookingError  String?
  viatorRetryCount    Int     @default(0)

  ticketToken     String? @unique
  ticketImageUrl  String? // Uploaded Viator ticket image (required before confirming)
  paymentProofUrl String? // Admin-uploaded payment proof (m-banking screenshot)

  reminderSentAt DateTime? // T-1 day reminder email send timestamp

  // Mock/manual booking fields
  isMockMode    Boolean @default(false)
  manualPrice   Float?
  promoCode     String?
  documentsJson Json?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  travelers BookingTraveler[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingTraveler {
  id         Int    @id @default(autoincrement())
  bookingRef String
  firstName  String
  lastName   String
  fullName   String
  ageBand    String

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum UserRole {
  ADMIN
  EDITOR
  USER
}

model Subscription {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("ACTIVE") // ACTIVE or UNSUBSCRIBED
  source    String   @default("WEBSITE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
}

// ===========================================================================
// AI SUBSCRIPTION + CREDIT SYSTEM
// ---------------------------------------------------------------------------
// Credit-based gating for AI endpoints. One credit ≈ 1,000 token-equivalents.
// Spend order: oldest expiresAt grant first (FIFO with TTL priority).
// Wallet.balance is a denormalised running total of sum(grants.remaining).
// ===========================================================================

model AiSubscription {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   String // FREE | EXPLORER | VOYAGER | FOUNDER
  status String // ACTIVE | GRACE | CANCELLED | EXPIRED | PENDING_PAYMENT

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  autoRenew      Boolean   @default(true)
  lastRenewalAt  DateTime?
  nextRenewalAt  DateTime?
  failedRenewals Int       @default(0)

  // Snapshot of pricing at signup so legacy users keep grandfathered terms
  priceIdr       Int
  monthlyCredits Int
  carryoverDays  Int
  carryoverCap   Int

  // Deferred plan change — applied at next renewal (downgrades). null = no pending change.
  pendingPlanKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, currentPeriodEnd])
}

model AiCreditWallet {
  userId         Int      @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  lifetimeSpent  Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model AiCreditGrant {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  source    String  // SUBSCRIPTION | TOPUP | PROMO | REFERRAL | LOYALTY_REDEEM | REFUND | ADJUST | BACKFILL
  amount    Int     // credits originally granted (positive)
  remaining Int     // credits left from this grant
  refId     String? // subscriptionId | aiPaymentId | referralCode | etc.

  grantedAt DateTime  @default(now())
  expiresAt DateTime
  expiredAt DateTime? // when expiry actually fired

  @@index([userId, expiresAt])
  @@index([userId, remaining])
}

model AiCreditLedger {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  delta  Int     // negative = spend, positive = grant/refund
  reason String  // GRANT_SUBSCRIPTION | GRANT_TOPUP | GRANT_BACKFILL | SPEND_CHAT | SPEND_PLAN | SPEND_REFUND | EXPIRE | ADJUST
  refId  String? // grantId | reservationId | aiPaymentId
  meta   Json?

  // For reservation/settlement: open ledger rows have settledAt=null
  reservationStatus String?  // RESERVED | SETTLED | CANCELLED
  settledAt         DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([reservationStatus])
  @@index([reservationStatus, settledAt])
}

model AiUsage {
  id          Int     @id @default(autoincrement())
  userId      Int?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash      String? // sha256(ip + salt) — guest rate-limit key
  endpoint    String  // chat | plan | search | concierge
  creditsCost Int
  tokensIn    Int?
  tokensOut   Int?
  model       String?
  durationMs  Int?
  status      String  // OK | DENIED_QUOTA | DENIED_AUTH | ERROR
  meta        Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@index([endpoint, status, createdAt])
}

model AiChatMemory {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rolling window of recent assistant/user turns for /api/ai/concierge.
  // Stored as Json: [{ role, content, ts }]. Capped to MAX_MEMORY_TURNS in service.
  messages  Json     @default("[]")
  /** Free-form profile snippets the assistant has remembered (preferences, names, etc.). */
  notes     Json     @default("[]")
  turnCount Int      @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AiFamilySeat {
  id           Int      @id @default(autoincrement())
  ownerUserId  Int
  owner        User     @relation("AiSeatOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  // Either an existing User (memberUserId) or a pending email invite (inviteEmail).
  memberUserId Int?     @unique
  member       User?    @relation("AiSeatMember", fields: [memberUserId], references: [id], onDelete: SetNull)
  inviteEmail  String?
  inviteToken  String?  @unique

  acceptedAt   DateTime?
  revokedAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerUserId])
  @@index([inviteEmail])
}

model AiPayment {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind           String  // SUBSCRIPTION_NEW | SUBSCRIPTION_RENEWAL | TOPUP
  plan           String? // for subscription kinds
  pack           String? // for topups
  creditsToGrant Int
  amountIdr      Int

  paymentId       String  @unique // Midtrans order_id (e.g. AISUB-123-ts)
  snapToken       String?
  status          String  // PENDING | PAID | FAILED | EXPIRED | REFUNDED
  paidAt          DateTime?
  midtransPayload Json?

  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}
